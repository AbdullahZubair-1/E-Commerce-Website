# Groq (free, no credit card): https://console.groq.com -> API Keys
GROQ_API_KEY=

# Cartesia TTS: https://cartesia.ai
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=79a125e8-cd45-4c13-8a67-188112f4dd22

# The e-commerce FastAPI backend, so Ana answers from your real product
# catalog instead of the open internet. Change if the backend runs elsewhere
# (e.g. http://backend:8000/api/v1 when both run inside docker-compose).
BACKEND_API_URL=http://localhost:8000/api/v1
